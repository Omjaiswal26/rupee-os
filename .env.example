# PostgreSQL
POSTGRES_USER=rupee
POSTGRES_PASSWORD=rupee_secret
POSTGRES_DB=rupee_os
DATABASE_URL=postgres://rupee:rupee_secret@postgres:5432/rupee_os?sslmode=disable

# Redis / Asynq
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# API
API_ADDR=:8080
API_CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=/data/uploads
MIGRATIONS_PATH=/app/migrations
MAX_UPLOAD_MB=20

# Ollama (local AI only — never send financial data externally)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# Heavier model for once-per-month health tip (pull separately).
OLLAMA_HEALTH_MODEL=qwen2.5:7b
CLASSIFICATION_MIN_CONFIDENCE=0.7
# Worker parallel Ollama calls (1–16). Match OLLAMA_NUM_PARALLEL. CPU ~8GB: start at 2.
CLASSIFY_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Logging
LOG_LEVEL=info
ENVIRONMENT=development
